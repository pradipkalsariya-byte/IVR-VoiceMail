# Local dev — Docker Postgres on host port 5446 (see docker-compose.yml).
# Synthetic seed only. No real parent data in this prototype (DPDP; see README).
DATABASE_URL="postgresql://nucleus:nucleus@localhost:5446/front_desk?schema=public"

# Who you are acting as in the demo. Any seeded staff email; the UI also has a switcher.
DEV_USER_EMAIL=frontdesk.fsk@fountainhead.test

# --- Seams that are STUBBED in this prototype -------------------------------------------
# Classification provider. "rules" = the deterministic stub (default, no network, no data
# leaves the machine). A model provider swaps in here once the AI-20 DPDP gate is cleared.
CLASSIFIER=rules

# Mail ingestion. "seed" = the synthetic corpus. "gmail" goes live with the four vars below —
# see tools/gmail-authorize.ts for the one-time consent flow that mints the refresh token.
MAIL_SOURCE=seed

# --- Gmail activation --------------------------------------------------------------------
# From the GCP console (project nucleus-prototypes): one OAuth client, type "Desktop app".
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN is written by `npm run gmail:authorize -- --account <mailbox>` — never by hand.
# GMAIL_SEND_AS=            # required to send anything at all; must be a registered send-as alias on the mailbox
# GMAIL_QUERY=              # optional Gmail search narrowing what ingestion sees

# --- Pilot mode -----------------------------------------------------------------------
# While the pilot is running, a real email reply is redirected to a reviewer instead of the
# real family — the real intended recipient is named inside the message body, never silently
# dropped. Off by default; both PILOT_MODE=true AND PILOT_REVIEWER_EMAIL are required together,
# or nothing redirects. The in-app rail is unaffected either way — it never leaves this system.
# This is a pilot flag with a deadline, not a permanent shape: the first thing to turn off at
# go-live (matches the estate's ENABLE_PERSONA_SWITCH convention — see repo-root CLAUDE.md).
# PILOT_MODE=true
# PILOT_REVIEWER_EMAIL=
# PILOT_CC_EMAILS=           # comma-separated

# --- Parent-app bridge (QM-D34(2): the front-office queue IS the front desk) -------------
# Dormant unless BOTH are set: /api/bridge/* answers 404 without the secret, and no push
# leaves without the URL. Local demo wiring only — production stays unset until the
# cutover is decided explicitly.
# PARENT_BRIDGE_SECRET=          # shared with nucleus-parent; any long random string
# PARENT_APP_WEBHOOK_URL=        # nucleus-parent's webhook, e.g. http://localhost:4700/api/frontdesk

# --- IVR voicemail (docs/IVR-VOICEMAIL-BRIEF.md) -----------------------------------------
# Dormant unless set: /api/voicemail answers 404 without a token, so a deploy with no PBX
# wired carries no new surface. Issue this to the vendor; they send it as X-Voicemail-Token.
# VOICEMAIL_WEBHOOK_TOKEN=       # any long random string
# Which dialled number maps to which campus (OrgUnit.code), "number:code,number:code".
# An unmapped number falls back to fsk (or the first seeded campus).
# VOICEMAIL_LINE_CAMPUS_MAP=
# Which IVR menu selection (YOCC/Enjay's own "Menu" column — Front Desk, Transport, …) emails
# which team, "Menu Label:team@address,Menu Label:team@address" (matched case-insensitively).
# VOICEMAIL_MENU_TEAM_MAP=
# Where an unmapped or absent menu's email goes. Unset means no notification email is sent for
# such a call — the Request record itself still files normally either way.
# VOICEMAIL_FALLBACK_TEAM_EMAIL=
# Used only to build the "Open: <url>/r/FD-0001" link in that notification email. Unset means
# the email just names the reference instead of linking it.
# APP_BASE_URL=

# Transcription provider. "none" (default) never calls out — every voicemail is filed
# unclassified and marked needs-a-listen, audio attached. "google" (VK, 03-Sep-2026: wired
# ahead of the brief's own five-recording Gujarati/Hindi/English test, on his explicit
# instruction — that test is still worth running against what this actually produces) calls
# Google Cloud Speech-to-Text's plain REST API with an API key, no client library.
TRANSCRIBER=none
# GOOGLE_STT_API_KEY=            # required for TRANSCRIBER=google; a Cloud Speech-to-Text API key
# GOOGLE_STT_LANGUAGE=en-IN      # default; the brief's own recommended family for code-switched calls
# GOOGLE_STT_ALT_LANGUAGES=hi-IN,gu-IN  # default
# GOOGLE_STT_ENCODING=           # only for a content type that isn't WAV/FLAC (those read their own header)
# GOOGLE_STT_SAMPLE_RATE_HZ=     # ditto — leave unset for WAV/FLAC
